// ig's intended architecture: edit freely; ig changes it only when you or an agent ask (ig accept, ig fmt, edits in the app, ig_edit).
app "ig-desktop" title="Desktop app" tech="Rust · Tauri" description="Tauri desktop app that shows the map and runs an AI agent session over the Agent Client Protocol." logo="tauri" {
    at "crates/ig-desktop/**"
    badges "ACP"
    pattern "none"
    calls "ig-app"
    calls "ig-core"
    calls "ig-fs" label="is_landscape"
    calls "ig-wire"
    module "ig-desktop/root" title="Tauri shell" tech="Rust · Tauri · Tokio" description="Tauri commands, events, permissions and the agent session behind the desktop window." {
        at "crates/ig-desktop/src/*"
    }
}
