// ig's intended architecture: edit freely; ig changes it only when you or an agent ask (ig accept, ig fmt, edits in the app, ig_edit).
module "ig-wire" title="Wiring" tech="Rust · notify" description="Wires the core, the filesystem, git, the language readers and the connectors together, and watches files for changes." {
    at "crates/ig-wire/**"
    pattern "none"
    calls "ig-app"
    uses "ig-conn-incus"
    uses "ig-conn-traefik"
    uses "ig-core"
    calls "ig-fs"
    calls "ig-git"
    uses "ig-lang-py"
    uses "ig-lang-rs"
    calls "ig-lang-ts"
    module "ig-wire/root" title="Wiring" tech="Rust · notify" description="Assembles the extractors and connectors into one pipeline and reloads on file changes." {
        at "crates/ig-wire/src/*"
    }
}
