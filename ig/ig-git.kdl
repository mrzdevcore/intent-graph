// ig's intended architecture: edit freely; ig changes it only when you or an agent ask (ig accept, ig fmt, edits in the app, ig_edit).
adapter "ig-git" title="Git" tech="Rust" description="Reads Git history and state for the map." logo="git" {
    at "crates/ig-git/**"
    pattern "none"
    calls "ig-core"
    adapter "ig-git/root" title="Git reader" tech="Rust · git CLI" description="Fills the Vcs port by running git: it finds the base and head, reads the history and manages worktrees." logo="git" {
        at "crates/ig-git/src/*"
    }
}
