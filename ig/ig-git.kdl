// ig's intended architecture: edit freely; ig changes it only when you or an agent ask (ig accept, ig fmt, edits in the app, ig_edit).
module "ig-git" title="ig git" tech="Rust" description="Fills the core's git port: reads facts from the repository's history." logo="git" {
    at "crates/ig-git/**"
    pattern "none"
    calls "ig-core"
    usecase "ig-git/root" title="Git adapter" tech="Rust" description="Reads git data for the map." logo="git" {
        at "crates/ig-git/src/*"
    }
}
