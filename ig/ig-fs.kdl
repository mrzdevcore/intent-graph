// ig's intended architecture: edit freely; ig changes it only when you or an agent ask (ig accept, ig fmt, edits in the app, ig_edit).
adapter "ig-fs" title="Filesystem" tech="Rust" description="Discovers projects and folders on disk for the core." {
    at "crates/ig-fs/**"
    pattern "none"
    calls "ig-core"
    adapter "ig-fs/root" title="Discovery" tech="Rust" description="Walks folders and discovers the files to read." {
        at "crates/ig-fs/src/*"
    }
}
