// ig's intended architecture: edit freely; ig changes it only when you or an agent ask (ig accept, ig fmt, edits in the app, ig_edit).
module "ig-core" title="Core" tech="Rust" description="Shared model, ports and architecture rules that every other crate depends on." {
    at "crates/ig-core/**"
    pattern "none"
    domain "ig-core/root" title="Model & ports" tech="Rust" description="The words of the map (model, workspace, config) and the ports for filesystem, HTTP and cache." {
        at "crates/ig-core/src/*"
        uses "ig-core/rules"
    }
    domain "ig-core/rules" title="Architecture rules" tech="Rust" description="Rules that check layers and architecture patterns against the imports." {
        at "crates/ig-core/src/rules/**"
        calls "ig-core/root"
    }
}
