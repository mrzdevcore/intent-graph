// ig's intended architecture: edit freely; ig changes it only when you or an agent ask (ig accept, ig fmt, edits in the app, ig_edit).
module "ig-lang-rs" title="Rust frontend" tech="Rust · tree-sitter" description="Language frontend that pulls modules, uses and symbols out of Rust sources." logo="rust" {
    at "crates/ig-lang-rs/**"
    pattern "none"
    calls "ig-core"
    usecase "ig-lang-rs/root" title="Rust extractor" tech="Rust · tree-sitter" description="Parses Rust with tree-sitter and pulls out imports and symbols." logo="rust" {
        at "crates/ig-lang-rs/src/*"
    }
}
